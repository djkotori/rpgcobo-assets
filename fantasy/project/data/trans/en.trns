				"desc":"It's a job that requires no special skills. However, if you master it, you can acquire a variety of useful abilities.",
				"name":"villagers"
			},
			"J001":{"desc":"A special profession that only a select few can attain.","name":"Hero"},
			"J100":{"name":"sense of justice"},
			"J101":{
				"desc":"Possesses an iron will that remains unshaken in any situation.\nDevelops resistance to mental status ailments.",
				"name":"Iron heart"
			},
			"J102":{"desc":"To defend a weakened ally.","name":"Chivalry"},
			"J103":{"name":"The art of stealing"},
			"J104":{"desc":"He dodges enemy attacks with light, nimble steps.","name":"Evasion Step"},
			"J105":{"desc":"Attack power increases at the start of battle.","name":"Be the first to win"}
		},
